# Copy to .env in the repo root (for docker-compose) and to apps/api/.env (for the API).

# Image tags to run — see https://github.com/rebakevin?tab=packages&repo_name=wizeai
API_IMAGE_TAG=
WEB_IMAGE_TAG=

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://wizeai:wizeai@localhost:5432/wizeai

# Google Gemini API key, used by the Google ADK PlannerService. Required — the
# server fails to boot without it. Get one from Google AI Studio; it starts
# with "AIza". Don't paste a Google OAuth token here (e.g. one starting with
# "AQ.") — it will look set but every Gemini call will fail with an auth error.
GEMINI_API_KEY=

# Better Auth. BETTER_AUTH_SECRET is required — the server fails to boot if
# it's empty. Generate one with `openssl rand -base64 32` (see DEVELOPMENT.md).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# Google OAuth (login + Calendar connection)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# WhatsApp Cloud API (see Meta App Dashboard > WhatsApp > API Setup)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any string you invent — must match what you enter in Meta's webhook Configuration screen.
WHATSAPP_VERIFY_TOKEN=
# Optional: App Dashboard > Settings > Basic. Enables webhook signature verification.
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_WEBHOOK_URL=https://YOUR-DOMAIN.ngrok-free.app/api/whatsapp/webhook

PORT=3001
