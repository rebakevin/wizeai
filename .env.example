# Copy to .env in the repo root (for docker-compose) and to apps/api/.env (for the API).

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://wizeai:wizeai@localhost:5432/wizeai

# Google Gemini API key, used by the Google ADK PlannerService
GEMINI_API_KEY=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# Google OAuth (login + Calendar connection)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# WhatsApp Cloud API (see Meta App Dashboard > WhatsApp > API Setup)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any string you invent — must match what you enter in Meta's webhook Configuration screen.
WHATSAPP_VERIFY_TOKEN=
# Optional: App Dashboard > Settings > Basic. Enables webhook signature verification.
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_WEBHOOK_URL=https://YOUR-DOMAIN.ngrok-free.app/api/whatsapp/webhook

PORT=3001
